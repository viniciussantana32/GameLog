# ==============================================================================
# Configurações do Ambiente - Meus Jogos (JOGOSSALVOS)
# Copie este arquivo para .env e preencha conforme seu ambiente
# ==============================================================================

FLASK_APP=run.py
FLASK_ENV=development
FLASK_CONFIG=development
SECRET_KEY=chave-secreta-aleatoria-substitua-em-producao

# ------------------------------------------------------------------------------
# Conexão com o Banco de Dados (DATABASE_URL)
# ------------------------------------------------------------------------------

# 1. Padrão: SQLite local (ideal para desenvolvimento rápido sem configurar servidores)
DATABASE_URL=sqlite:///jogossalvos.db

# 2. MySQL (Banco JOGOSSALVOS com driver PyMySQL):
# DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/JOGOSSALVOS

# 3. PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://usuario:senha@localhost:5432/JOGOSSALVOS

# ------------------------------------------------------------------------------
# Credenciais da API IGDB (Twitch Developer):
# Cadastre uma aplicação gratuita em: https://dev.twitch.tv/console
# ------------------------------------------------------------------------------
IGDB_CLIENT_ID=seu_client_id_aqui
IGDB_CLIENT_SECRET=seu_client_secret_aqui

